{
  "schema_version": 1,
  "layer": 1,
  "name": "国标层（GB/T 7714 双标尺通用 + 全文线国标依据）",
  "overlay_semantics": "四层叠加顺序：国标 → 年份 → 期刊 profile → 学校 profile；后层只做增量覆盖，覆盖动作留审计痕迹（plan/04 §二）",
  "activation_semantics": "status=条款核对状态（官方原文不可得→pending，禁冒充原文）；activation=检测生效开关（active/gated）。两者正交，裁定见 plan/04 §十。basis 为该检测的事实依据（工程口径/合成真值契约）",
  "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]},
  "rules": [
    {
      "rule_id": "GBT7714-punct-01",
      "scope": "reference.format",
      "standard": "GB/T 7714",
      "clause": "著录标点（条号待原文核对）",
      "quote": "",
      "status": "pending",
      "activation": "active",
      "basis": "合成真值契约：gen_references 标点注入六型（txt/csv 逗号·句点·冒号·多余逗号；bib 字段逗号缺失；ris 标签短横），注释/字段区逐条留痕",
      "severity": "error",
      "check_type": "punct",
      "detect": {"param": "citation_text", "op": "punct_pattern", "value": "著者间', '、题名后'[类型标识]'、出版项前'. '"},
      "fix": {"type": "auto", "template": "全半角标点归一 + 缺失标点补齐"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
