{
  "schema_version": 1,
  "layer": 1,
  "name": "国标层（GB/T 7714 双标尺通用 + 全文线国标依据）",
  "overlay_semantics": "四层叠加顺序：国标 → 年份 → 期刊 profile → 学校 profile；后层只做增量覆盖，覆盖动作留审计痕迹（plan/04 §二）",
  "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]},
  "rules": [
    {
      "rule_id": "GBT7714-punct-01",
      "scope": "reference.format",
      "standard": "GB/T 7714",
      "clause": "著录标点（条号待原文核对）",
      "quote": "",
      "status": "pending",
      "severity": "error",
      "check_type": "punct",
      "detect": {"param": "citation_text", "op": "punct_pattern", "value": "著者间', '、题名后'[类型标识]'、出版项前'. '"},
      "fix": {"type": "auto", "template": "全半角标点归一 + 缺失标点补齐"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "GBT7714-fieldreq-J-01",
      "scope": "reference.format",
      "standard": "GB/T 7714",
      "clause": "期刊条目著录项目（条号待原文核对）",
      "quote": "",
      "status": "pending",
      "severity": "error",
      "check_type": "field_required",
      "detect": {"param": "entry_type", "op": "required_fields", "value": ["题名", "刊名", "年", "卷(期)", "页码"]},
      "fix": {"type": "suggest", "template": "补齐缺失著录项或标 manual_confirm"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "GBT7714-fieldreq-M-01",
      "scope": "reference.format",
      "standard": "GB/T 7714",
      "clause": "图书条目著录项目（条号待原文核对）",
      "quote": "",
      "status": "pending",
      "severity": "error",
      "check_type": "field_required",
      "detect": {"param": "entry_type", "op": "required_fields", "value": ["书名", "出版地", "出版社", "年份"]},
      "fix": {"type": "suggest", "template": "补齐缺失著录项或标 manual_confirm"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "GBT7714-author-01",
      "scope": "reference.format",
      "standard": "GB/T 7714",
      "clause": "著者数量与'等'的用法（条号待原文核对）",
      "quote": "",
      "status": "pending",
      "severity": "error",
      "check_type": "author_threshold",
      "detect": {"param": "authors", "op": "threshold", "value": "≤3 全列；>3 取前三 + '等'（西文 et al）"},
      "fix": {"type": "auto", "template": "按阈值截断并追加 等/et al"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "GBT7714-marker-01",
      "scope": "reference.format",
      "standard": "GB/T 7714",
      "clause": "文献类型标识（条号待原文核对）",
      "quote": "",
      "status": "pending",
      "severity": "error",
      "check_type": "type_marker",
      "detect": {"param": "type_marker", "op": "in", "value": ["J", "M", "D", "C", "N", "R", "P", "S", "A", "DB/OL"]},
      "fix": {"type": "auto", "template": "按载体与内容改写标识"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "GBT7714-pagerange-01",
      "scope": "reference.format",
      "standard": "GB/T 7714",
      "clause": "页码著录（条号待原文核对）",
      "quote": "",
      "status": "pending",
      "severity": "error",
      "check_type": "page_range",
      "detect": {"param": "pages", "op": "range_order", "value": "起页 ≤ 止页，连接号 '-'"},
      "fix": {"type": "auto", "template": "起止页升序重排"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "GBT7714-citestyle-01",
      "scope": "reference.style",
      "standard": "GB/T 7714",
      "clause": "编码制选用一致性（顺序编码制 / 著者-出版年制，条号待原文核对）",
      "quote": "",
      "status": "pending",
      "severity": "error",
      "check_type": "citation_style",
      "detect": {"param": "citation_entries", "op": "single_style", "value": "全表不得混用两种编码制"},
      "fix": {"type": "suggest", "template": "按主体编码制统一重排"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "GBT7713-struct-01",
      "scope": "thesis.structure",
      "standard": "GB/T 7713.1-2025",
      "clause": "章节编号与层级（条号待原文核对；现行版本 2025-08-01 发布、2026-02-01 实施，已查证）",
      "quote": "",
      "status": "pending",
      "severity": "error",
      "check_type": "structure_order",
      "detect": {"param": "heading_sequence", "op": "level_continuity", "value": "章→节→小节逐级递进，不跳级"},
      "fix": {"type": "suggest", "template": "提示层级断档位置"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "GBT15835-num-01",
      "scope": "thesis.number_usage",
      "standard": "GB/T 15835-2011",
      "clause": "数字用法一致性（条号待原文核对，现行版本待查证）",
      "quote": "",
      "status": "pending",
      "severity": "warn",
      "check_type": "term_consistency",
      "detect": {"param": "number_forms", "op": "consistent_form", "value": "同一量值全篇同形（千分位/全半角/百分比）"},
      "fix": {"type": "suggest", "template": "给出不一致位置清单"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "TAW-xref-dangling-01",
      "scope": "thesis.cross_reference",
      "standard": "GB/T 7713.1-2025",
      "clause": "图表公式须先定义后引用（工程规则：工具口径，非标准原文）",
      "quote": "",
      "status": "pending",
      "severity": "error",
      "check_type": "dangling_reference",
      "detect": {"param": "markers", "op": "target_exists", "value": "每个标记可解析到唯一存在的对象"},
      "fix": {"type": "suggest", "template": "提示悬空标记位置"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "TAW-xref-ghost-01",
      "scope": "thesis.cross_reference",
      "standard": "GB/T 7713.1-2025",
      "clause": "图表公式应在正文中被提及（工程规则：工具口径，非标准原文）",
      "quote": "",
      "status": "pending",
      "severity": "warn",
      "check_type": "ghost_object",
      "detect": {"param": "objects", "op": "mentioned", "value": "对象至少被正文提及一次"},
      "fix": {"type": "suggest", "template": "提示幽灵对象位置"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    },
    {
      "rule_id": "TAW-aigc-signal-01",
      "scope": "thesis.aigc",
      "standard": "taw AIGC 特征库（data/knowledge/aigc_features.json）",
      "clause": "AIGC 痕迹启发式（风险提示版）",
      "quote": "",
      "status": "pending",
      "severity": "warn",
      "check_type": "aigc_signal",
      "detect": {"param": "aigc_features", "op": "feature_threshold", "value": "按特征权重与阈值给出风险提示"},
      "fix": {"type": "suggest", "template": "仅提示位置与特征名；不提供任何改写通路（plan/04 §六）"},
      "only_if_text": [],
      "gates": {"standard_year": ["2015", "2025"], "profile": ["default", "journal-*", "school-*"]}
    }
  ]
}
